# Deployment settings (prefix PR_). Secrets must come from the environment or a secret manager.
PR_DB_PATH=permrag.db
PR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Token verification. HS256 needs a secret of at least 32 bytes; RS256/ES256 need a PEM public key.
PR_JWT_KEY=
PR_JWT_ALGORITHM=HS256
# PR_JWT_ISSUER=https://idp.example.com/
# Audit chain key (>= 16 bytes). Keep it outside the database and back it up separately.
PR_AUDIT_HMAC_KEY=
PR_ADMIN_ROLE_NAME=admin
PR_RATE_LIMIT_PER_MINUTE=60
PR_AUDIT_LOG_QUERY_TEXT=false
PR_DEFAULT_TOP_K=5
PR_MAX_TOP_K=20
# Optional generation. /v1/search works without it.
# PR_LLM_PROVIDER=anthropic        # or openai_compat
# PR_LLM_MODEL_ID=
# PR_LLM_BASE_URL=                 # for openai_compat servers, e.g. http://localhost:11434/v1
# PR_LLM_API_KEY_ENV=ANTHROPIC_API_KEY   # NAME of the variable that holds the key
